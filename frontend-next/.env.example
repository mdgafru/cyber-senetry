# cybersentry360 — Environment Variables
# Local: copy to .env.local
# Vercel: Project Settings → Environment Variables (Production + Preview)

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (required for generation + cron)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Public site URL — use your Vercel domain in production
# Example: https://cybersentry360.vercel.app  OR  https://www.cybersentry360.com
NEXT_PUBLIC_SITE_URL=https://www.cybersentry360.com

# Cron security — must match Vercel CRON Authorization (set same value in Vercel)
CRON_SECRET=generate-a-long-random-string-here

# Unsplash — topic-based hero images (https://unsplash.com/oauth/applications)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
